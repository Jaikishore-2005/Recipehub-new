{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "github": {
    "enabled": true,
    "silent": true
  },
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "skipCache": true,
        "zeroConfig": true,
        "buildCommand": "echo 'Removing TestApiConnection reference'; sed -i '/TestApiConnection/d' ./src/App.tsx && npm run build"
      }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
} 